<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="TheHackerist.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <enyo:AvaEnyoTheme Density="Default" />
    <enyo:AvaEnyoControlsTheme />
    <enyo:AvaEnyoServicesTheme />
    <StyleInclude Source="avares://TheHackerist.Core/Views/HackeristStyles.axaml" />
  </Application.Styles>
</Application>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheHackerist.Android</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);IL2026;IL2045;IL2072;IL2075;IL2121</NoWarn>
    <ApplicationId>com.drasticactions.hackerist</ApplicationId>
    <ApplicationTitle>Hackerist</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="..\TheHackerist.Core\Assets\Icon.png" Link="Resources\mipmap\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheHackerist.Core\TheHackerist.Core.csproj" />
  </ItemGroup>

</Project>

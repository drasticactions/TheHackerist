<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <!-- Shown while the app starts; replaced by the main theme once the first frame is ready. -->
  <style name="HackeristTheme.Splash" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/window_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="postSplashScreenTheme">@style/HackeristTheme.NoActionBar</item>
  </style>

  <style name="HackeristTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/window_background</item>
  </style>
</resources>

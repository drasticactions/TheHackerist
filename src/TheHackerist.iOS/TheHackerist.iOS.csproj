<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheHackerist.iOS</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <ApplicationId>com.drasticactions.hackerist</ApplicationId>
    <ApplicationTitle>Hackerist</ApplicationTitle>
    <NoWarn>$(NoWarn);IL2026;IL2045;IL2072;IL2075;IL2121</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>all</MtouchInterpreter>
    <MtouchLink Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">None</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheHackerist.Core\TheHackerist.Core.csproj" />
  </ItemGroup>

</Project>

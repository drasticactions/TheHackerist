# The Linux build image: Ubuntu 22.04 (glibc 2.35) with the NativeAOT toolchain and the .NET 10 SDK.
# tools/linux/container.sh builds it on first use and runs commands in it.
FROM docker.io/library/ubuntu:22.04
COPY deps.sh /tmp/hackerist/
RUN sh /tmp/hackerist/deps.sh --dotnet && rm -rf /tmp/hackerist
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
